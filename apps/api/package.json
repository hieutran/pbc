{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc && esbuild src/index.ts --bundle --outfile=dist/index.js --format=esm --platform=node",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "lint": "echo 'No linting configured yet'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "clean": "rm -rf dist",
    "db:migrate": "wrangler d1 migrations apply pbc-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply pbc-db"
  },
  "dependencies": {
    "@pbc/shared": "workspace:*",
    "hono": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "@vitest/coverage-v8": "^4.0.8",
    "esbuild": "^0.20.0",
    "miniflare": "^4.20251109.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.8",
    "wrangler": "^3.25.0"
  }
}
